# Resend Daily Briefing — environment variables
# Copy to .env and fill in. See README for how to obtain each value.

# --- Server ---
PORT=8787
# Optional: mount the app under a subpath, e.g. "/resend" when served behind a reverse proxy.
APP_BASE_PATH=

# --- Cron auth ---
# Shared secret required in the X-Cron-Secret header for POST /cron/briefing.
CRON_SECRET=

# --- GitHub API (read commits/pulls/issues of the watched repos) ---
# Personal access token (classic) with public_repo scope, or a fine-grained token with
# read access to the three repos. Without a token you hit the 60 req/hour anonymous limit.
GH_TOKEN=

# Comma-separated list of "owner/repo" to watch. Defaults to the three showcase repos.
WATCHED_REPOS=resend/resend,supabase/supabase,NangoHQ/nango

# --- OpenAI (analysis of changes) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Resend (sending the briefing + confirmation emails) ---
RESEND_API_KEY=
# Verified sender domain or email. Example: "briefing@yourdomain.com" or "Juan <briefing@yourdomain.com>"
RESEND_FROM=

# --- Supabase (subscribers + dispatches log) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
